   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget {
	background-color: #1e1e1e;
	color: #d4d4d4;
}

QLabel {
	color: #d4d4d4;
}

QLabel#titleLabel {
	color: #ffffff;
	font-size: 26px;
	font-weight: bold;
}

QGroupBox {
	background-color: #252526;
	border: 1px solid #454545;
	border-radius: 8px;
	margin-top: 16px;
	padding: 8px;
}

QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 14px;
	padding: 0 6px;
	color: #4fc1ff;
}

QPushButton {
	background-color: #333333;
	color: #ffffff;
	border: 1px solid #555555;
	border-radius: 6px;
	padding: 10px 16px;
}

QPushButton:pressed {
	background-color: #094771;
	border-color: #4fc1ff;
}

QPushButton:disabled {
	background-color: #292929;
	color: #777777;
	border-color: #383838;
}

QPushButton#exitButton {
	background-color: #683333;
}

QPushButton#exitButton:pressed {
	background-color: #8c4242;
}

QLabel#accelLabel, QLabel#gyroLabel {
	font-size: 18px;
}

QLabel#apStatusLabel, QLabel#icmStatusLabel {
	color: #dcdcaa;
}


QWidget {
	font-family: Consolas;
	font-size: 18px;
}

QWidget#monitorPage, QWidget#settingsPage {
	background-color: #1e1e1e;
}

QTabWidget::pane {
	border: 1px solid #454545;
	border-radius: 6px;
}

QTabBar::tab {
	background-color: #2d2d30;
	color: #d4d4d4;
	min-width: 140px;
	min-height: 40px;
	padding: 0 16px;
}

QTabBar::tab:selected {
	background-color: #094771;
	color: #ffffff;
}

QCheckBox {
	color: #d4d4d4;
	spacing: 10px;
}

QCheckBox::indicator {
	width: 24px;
	height: 24px;
}

QCheckBox:disabled {
	color: #777777;
}

QSpinBox {
	background-color: #333333;
	color: #ffffff;
	border: 1px solid #555555;
	border-radius: 6px;
	padding: 4px 40px 4px 12px;
}

QSpinBox::up-button, QSpinBox::down-button {
	width: 32px;
}

QLabel#configPathLabel {
	font-size: 14px;
	color: #999999;
}

QLabel#settingsHintLabel {
	color: #dcdcaa;
}

QPushButton#applySettingsButton {
	background-color: #094771;
}


QLabel#recordInfoLabel {
	font-size: 16px;
	color: #999999;
}

QLabel#recordPathLabel {
	font-size: 14px;
}

QPushButton#recordButton {
	background-color: #094771;
}
</string>
